public OnPlayerStateChange(playerid, newstate, oldstate)
{
    if(newstate == PLAYER_STATE_ONFOOT && oldstate == PLAYER_STATE_DRIVER)
    {
        // Verifica se o veículo que ele saiu é o que ele alugou
        if(VeiculoAluguel[playerid] != INVALID_VEHICLE_ID)
        {
            DestroyVehicle(VeiculoAluguel[playerid]);
            VeiculoAluguel[playerid] = INVALID_VEHICLE_ID;
            SendClientMessage(playerid, -1, "{FF8000}[LOCALIZA]: {FFFFFF}O veículo foi recolhido pois você desembarcou.");
        }
    }
	return 1;
}

