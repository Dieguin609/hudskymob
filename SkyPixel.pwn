public OnPlayerPickUpPickup(playerid, pickupid)
{
    if(pickupid == PickupPrefAtendimento1 || pickupid == PickupPrefAtendimento2)
    {
        // ATENÇÃO: Coloca aqui o link do teu GitHub Pages onde meteste o prefeitura.html
        Geckoju_CreateBrowser(playerid, 102, -1, -1, 0, 0, "https://dieguin609.github.io/hudskymob/prefeitura.html", true, false);
        Geckoju_SetInteractive(playerid, 102, true);
        
        PlayerPlaySound(playerid, 1083, 0.0, 0.0, 0.0); // Som de abrir painel
        return 1;
    }
    // ================= [ ENTRANDO NA PREFEITURA ] =================
    if(pickupid == PickupPrefeituraEntrada)
    {
        // Define o interior para a Burglary House 13 (ID 5)
        SetPlayerInterior(playerid, 5);
        
        // Coloca ele lá dentro, um passinho pra frente da porta (Y + 2.0) pra não bugar
        SetPlayerPos(playerid, 140.3679, 1369.8837, 1083.8621);
        SetPlayerFacingAngle(playerid, 0.0);
        
        // Somzinho de porta abrindo
        PlayerPlaySound(playerid, 1144, 0.0, 0.0, 0.0);
        return 1;
    }

    // ================= [ SAINDO DA PREFEITURA ] =================
    if(pickupid == PickupPrefeituraSaida)
    {
        // Volta pro mundo normal (Rua = Interior 0)
        SetPlayerInterior(playerid, 0);
        
        // Coloca ele lá fora, um passinho pra frente da seta de entrada (Y - 3.0)
        SetPlayerPos(playerid, 1480.616455, -1780.949462, 21.090301);
        SetPlayerFacingAngle(playerid, 0.0);
        
        // Somzinho de porta
        PlayerPlaySound(playerid, 1144, 0.0, 0.0, 0.0);
        return 1;
    }
    
    return 1;
}

