// =============================================================================
// SISTEMA DE EVENTOS E SPAWN MOBILE - INTEGRADO COM SISTEMA DE CONTAS
// =============================================================================

forward OnGeckojuEvent(playerid, browserid, eventType, const data[]);
public OnGeckojuEvent(playerid, browserid, eventType, const data[])
{
    // -------------------------------------------------------------------
    // 1. QUANDO A PÁGINA CARREGA (Para enviar o Nome e CPF para o painel)
    // -------------------------------------------------------------------
    if (eventType == GECKOJU_EVENT_LOADED && browserid == 102)
    {
        new nome[MAX_PLAYER_NAME], scriptJS[128];
        GetPlayerName(playerid, nome, sizeof(nome));
        
        // Aqui enviamos o Nome real e um CPF fictício para a função setDadosCidadao() que criaste no HTML
        format(scriptJS, sizeof(scriptJS), "setDadosCidadao('%s', '123.456.789-00');", nome);
        Geckoju_ExecuteJS(playerid, 102, scriptJS);
        return 1;
    }

    // -------------------------------------------------------------------
    // 2. QUANDO O JOGADOR CLICA NOS BOTÕES DO PAINEL
    // -------------------------------------------------------------------
    if (eventType == GECKOJU_EVENT_CUSTOM)
    {
        // FECHAR O MENU PELO "X"
        if (strcmp(data, "fechar_prefeitura") == 0)
        {
            Geckoju_DestroyBrowser(playerid, 102);
            return 1;
        }

        // CARREGAR DADOS NA TELA DA PREFEITURA
        if (strcmp(data, "carregar_dados_pref") == 0)
        {
            new nome[MAX_PLAYER_NAME], scriptJS[128], displayCPF[20];
            GetPlayerName(playerid, nome, sizeof(nome));
            
            // ⚠️ ATENÇÃO: Deixe "Nao Emitido" SEM ACENTO para não crashar o JS!
            if(strcmp(PlayerCPF[playerid], "Nenhum") == 0) {
                format(displayCPF, sizeof(displayCPF), "Nao Emitido"); 
            } else {
                format(displayCPF, sizeof(displayCPF), "%s", PlayerCPF[playerid]);
            }
            
            // Manda pro Javascript preencher o perfil (Lembre-se de verificar se o ID 102 é o certo do seu Browser da prefeitura)
            // Exemplo: Se criou o browser no ID 102, mande para o 102!
            format(scriptJS, sizeof(scriptJS), "setDadosCidadao('%s', '%s');", nome, PlayerCPF[playerid]);
            Geckoju_ExecuteJS(playerid, 102, scriptJS);
            
            return 1;
        }
        // EMITIR RG
        // 2. BOTÃO DE EMITIR RG / CPF
        if (strcmp(data, "pref_rg") == 0)
        {
            // 1. Fecha o menu da prefeitura (Usei o ID 102 no exemplo anterior)
            Geckoju_DestroyBrowser(playerid, 102);

            // 2. Se ele já tiver o CPF, bloqueia (Sem acento no JS)
            if(strcmp(PlayerCPF[playerid], "Nenhum") != 0) {
                Geckoju_ExecuteJS(playerid, HUD_BROWSER_ID2, "showNotification('error', 'Voce ja possui um Registro Geral!');");
                return 1;
            }

            // 3. Gera 11 números aleatórios realistas
            // Gera 11 números aleatórios realistas
            format(PlayerCPF[playerid], 24, "%03d.%03d.%03d-%02d", random(900)+100, random(900)+100, random(900)+100, random(90)+10);
            // 4. Salva de forma segura chamando a SUA função que já está pronta!
            SalvarDados(playerid);

            // 5. Avisa no HUD o número gerado! (SEM ACENTOS NO TEXTO!)
            new msg[128];
            format(msg, sizeof(msg), "showNotification('success', 'RG emitido! Seu CPF: %s');", PlayerCPF[playerid]);
            Geckoju_ExecuteJS(playerid, HUD_BROWSER_ID2, msg);
            
            return 1;
        }

        // BOLSA FAMÍLIA (O botão "Se Inscrever")
        if (strcmp(data, "bolsa_inscrever") == 0)
        {
            Geckoju_DestroyBrowser(playerid, 102);
            Geckoju_ExecuteJS(playerid, HUD_BROWSER_ID2, "showNotification('error', 'O sistema do Bolsa Familia ainda nao esta disponivel.');");
            return 1;
        }

        // CLT (O botão "Emitir Carteira")
        if (strcmp(data, "clt_emitir") == 0)
        {
            Geckoju_DestroyBrowser(playerid, 102);
            Geckoju_ExecuteJS(playerid, HUD_BROWSER_ID2, "showNotification('success', 'Sua Carteira de Trabalho (CLT) foi assinada!');");
            return 1;
        }

        // JUNTA MILITAR (O botão "Alistar-se")
        if (strcmp(data, "militar_alistar") == 0)
        {
            Geckoju_DestroyBrowser(playerid, 102);
            Geckoju_ExecuteJS(playerid, HUD_BROWSER_ID2, "showNotification('success', 'Alistamento militar concluido. Aguarde a convocacao!');");
            return 1;
        }
    }
    if (eventType == GECKOJU_EVENT_CUSTOM)
    {
        // =================================================================
        // PARTE 1: LOGIN, REGISTRO, SPAWNS (MANTIDO IGUAL)
        // =================================================================

        if (strfind(data, "login:") == 0) 
        {
            new pass[64];
            strmid(pass, data, 6, strlen(data));
            for(new i = 0; i < strlen(pass); i++) { if(pass[i] < 33) pass[i] = '\0'; }
            OnPlayerLogin(playerid, pass);
            return 1;
        }

        if (strfind(data, "register:") == 0)
        {
            new pass[64], gen[10];
            if (!sscanf(data, "p<:> {s[9]} s[64] s[10]", pass, gen)) {
                OnPlayerRegister(playerid, pass, gen);
            }
            return 1;
        }

        if (strfind(data, "event:spawnUltima") != -1)    return OnPlayerSpawnUltima(playerid, browserid);
        if (strfind(data, "event:spawnAeroporto") != -1) return OnPlayerSpawnAeroporto(playerid, browserid);
        if (strfind(data, "event:spawnEstac1") != -1)    return OnPlayerSpawnEstac1(playerid, browserid);
        if (strfind(data, "event:spawnEstac2") != -1)    return OnPlayerSpawnEstac2(playerid, browserid);


        // =================================================================
        // PARTE 2: MENU, MAPA E GPS (ATUALIZADO COM ROTAS REAIS)
        // =================================================================
        // --- SISTEMA DE RECÁLCULO DO GPS ---
        if(strcmp(data, "recalcular_gps", true) == 0)
        {
            // Só recalcula se ele realmente tiver uma rota ativa
            if(GPS_Ativo[playerid])
            {
                new MapNode:startNode, MapNode:endNode;
                new Float:pX, Float:pY, Float:pZ;
                GetPlayerPos(playerid, pX, pY, pZ);
                
                // Acha a rua nova onde você está perdido agora
                if(GetClosestMapNodeToPoint(pX, pY, pZ, startNode) == 0)
                {
                    // Acha o destino que já tava salvo
                    if(GetClosestMapNodeToPoint(GPS_DestX[playerid], GPS_DestY[playerid], GPS_DestZ[playerid], endNode) == 0)
                    {
                        SendClientMessage(playerid, -1, "{FF0000}[GPS] {FFFF00}Rota perdida. Recalculando...");
                        FindPathThreaded(startNode, endNode, "OnRotaCalculada", "i", playerid);
                    }
                }
            }
            return 1;
        }
        // 1. ABRIR MENU
        if(strcmp(data, "menu", true) == 0)
        {
            Geckoju_CreateBrowser(
                playerid, 
                MENU_BROWSER_ID, 
                0, 0, 0, 0, // Fullscreen
                "https://dieguin609.github.io/hudskymob/menu.html", 
                true, false
            );
            
            Geckoju_SetInteractive(playerid, MENU_BROWSER_ID, true);
            // TogglePlayerControllable(playerid, 0); // Opcional: Congelar player
            return 1;
        }

        // 2. ABRIR MAPA GLOBAL
        if(strcmp(data, "abrir_mapa_global", true) == 0)
        {
            Geckoju_CreateBrowser(playerid, 5, 0, 0, 0, 0, "https://dieguin609.github.io/hudskymob/mapa_global.html", true, false);
            Geckoju_SetInteractive(playerid, 5, true);

            new Float:px, Float:py, Float:pz, Float:pa;
            GetPlayerPos(playerid, px, py, pz);
            GetPlayerFacingAngle(playerid, pa);
            
            new json[128];
            // Adicionamos "first_open":true para o HTML saber que deve dar o zum
            format(json, sizeof(json), "{\"x\":%.2f,\"y\":%.2f,\"a\":%.2f,\"first_open\":true}", px, py, pa);
            Geckoju_SendData(playerid, 5, json); 
            return 1;
        }
        // 3. FECHAR
        if(strcmp(data, "fechar_menu", true) == 0 || strcmp(data, "fecharMapaGlobal", true) == 0)
        {
            Geckoju_DestroyBrowser(playerid, MENU_BROWSER_ID);
            Geckoju_DestroyBrowser(playerid, MAPA_BROWSER_ID);
            // TogglePlayerControllable(playerid, 1); // Descongelar
            return 1;
        }

        // Se o player clicar em Alugar na Web
        if(strfind(data, "alugar_veiculo:462") != -1)
        {
            // Verificação zerada (proposital)
            if(GetPlayerMoney(playerid) < 0) 
            {
                // ⚠️ ATENÇÃO: Troque o '0' abaixo pelo ID do Browser onde o seu HUD (index2.html) está rodando!
                Geckoju_ExecuteJS(playerid, HUD_BROWSER_ID2, "showNotification('error', 'Você não tem dinheiro para o aluguel.');");
                return 1;
            }

            // Se ele já tiver uma moto alugada, apaga a velha
            if(VeiculoAluguel[playerid] != INVALID_VEHICLE_ID) {
                DestroyVehicle(VeiculoAluguel[playerid]);
            }

            // Não cobra nada
            GivePlayerMoney(playerid, 0);

            // Cria a Fagio na posição que você passou
            VeiculoAluguel[playerid] = CreateVehicle(462, 1671.568847, -2256.339843, 13.367939, 0.0, 1, 1, -1);
            
            // Coloca o player direto na moto
            PutPlayerInVehicle(playerid, VeiculoAluguel[playerid], 0);
            
            // Fecha o menu da Localiza (que você criou no ID 101)
            Geckoju_DestroyBrowser(playerid, 101);
            
            // Manda a notificação de sucesso e toca o áudio no HUD!
            // ⚠️ ATENÇÃO: Novamente, troque esse '0' pelo ID do Browser do seu HUD!
            Geckoju_ExecuteJS(playerid, HUD_BROWSER_ID2, "showNotification('success', 'Veículo alugado! O aluguel expira ao sair.');");
            
            return 1;
        }

        if (strcmp(data, "fechar_localiza") == 0)
        {
            // Fecha o menu de forma segura direto pelo servidor
            Geckoju_DestroyBrowser(playerid, browserid);
            return 1;
        }
        // 4. GPS: SISTEMA INTELIGENTE (ATUALIZADO)
        // Dentro do public OnGeckojuEvent(playerid, const data[])

// Verifica se o dado recebido começa com "gps_destino|"
// Dentro do public OnGeckojuEvent...

// Verifica se o site mandou o comando "gps_destino|"
        // Dentro do OnGeckojuEvent...

// Verifica se é o comando de destino
        if(strfind(data, "gps_destino|", true) != -1)
        {
            // Segurança: Se a string for curta demais, ignora pra não bugar
            if(strlen(data) < 13) return 1;

            new Float:destX, Float:destY;
            
            // "data[12]" pula o prefixo "gps_destino|"
            if(!sscanf(data[12], "p<|>ff", destX, destY))
            {
                // DEBUG
                /*
                new debug_str[128];
                format(debug_str, sizeof(debug_str), "{FFFF00}[DEBUG] X: %.2f | Y: %.2f", destX, destY);
                SendClientMessage(playerid, -1, debug_str);
                */

                if(destX == 0.0 && destY == 0.0) 
                {
                    SendClientMessage(playerid, -1, "{FF0000}[Erro] GPS falhou (Coord 0.0).");
                    return 1;
                }

                SendClientMessage(playerid, -1, "{FFFF00}[GPS] Processando rota...");

                new MapNode:startNode, MapNode:endNode;
                new Float:pX, Float:pY, Float:pZ;
                GetPlayerPos(playerid, pX, pY, pZ);
                
                // 1. Acha o nó inicial (Onde você está)
                if(GetClosestMapNodeToPoint(pX, pY, pZ, startNode) != 0) 
                {
                    SendClientMessage(playerid, -1, "{FF0000}[GPS] Erro: Vá para uma rua asfaltada para iniciar.");
                    return 1;
                }

                // --- CORREÇÃO DE VIADUTO (Start) ---
                // Verifica se o nó achado não está muito longe verticalmente (embaixo de ponte)
                new Float:nX, Float:nY, Float:nZ;
                GetMapNodePos(startNode, nX, nY, nZ);
                if(floatabs(pZ - nZ) > 10.0)
                {
                    SendClientMessage(playerid, -1, "{FF0000}[GPS] Alerta: O sistema achou uma rua muito acima ou abaixo de você.");
                }
                
                // 2. Acha o nó final (Onde você clicou)
                // Se falhar (clicou na água ou fora do mapa), PARA TUDO.
                if(GetClosestMapNodeToPoint(destX, destY, pZ, endNode) != 0)
                {
                    SendClientMessage(playerid, -1, "{FF0000}[GPS] Local inválido (sem rua perto). Tente clicar em outro lugar.");
                    return 1; // <--- ISSO FALTAVA! Se não tiver nó, não pode continuar.
                }

                // --- CORREÇÃO DE ALTURA DO DESTINO ---
                // Pega a altura real da rua no destino para o checkpoint ficar no chão
                new Float:destZ_Real;
                GetMapNodePos(endNode, destX, destY, destZ_Real);

                // 3. Calcula a rota
                // Chama a função que manda os pedaços (OnRotaCalculada -> EnviarPedacosRota)
                FindPathThreaded(startNode, endNode, "OnRotaCalculada", "i", playerid);
                
                // 4. Salva as variáveis
                GPS_DestX[playerid] = destX;
                GPS_DestY[playerid] = destY;
                GPS_DestZ[playerid] = destZ_Real; // Usa a altura da rua, não a sua!
                GPS_Ativo[playerid] = true;

                // 5. Cria checkpoint e Timer
                SetPlayerCheckpoint(playerid, destX, destY, destZ_Real, 6.0);

                // Reinicia o timer de checagem de chegada
                if(GPS_Timer[playerid] != 0) KillTimer(GPS_Timer[playerid]);
                GPS_Timer[playerid] = SetTimerEx("GPS_Pulse", 2000, true, "i", playerid);
                
                // O GPS_Pulse verifica chegada. O desenho da linha é feito pelo FindPathThreaded.
            }
            return 1;
        }
    }
    return 1;
}
// Coloque isso no final do seu GM e garanta que SetTimer("GlobalTimerHud", 200, true); está no OnGameModeInit

forward GlobalTimerHud();
public GlobalTimerHud()
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i))
        {
            new Float:x, Float:y, Float:z, Float:a;
            GetPlayerPos(i, x, y, z);
            GetPlayerFacingAngle(i, a);

            // 1. JSON PARA A SETA DO MAPA GRANDE (ID 5)
            // O HTML novo espera "pX", "pY" e "angle"
            new jsonMap[128];
            format(jsonMap, sizeof(jsonMap), "{\"pX\":%.2f,\"pY\":%.2f,\"angle\":%.2f}", x, y, a);
            Geckoju_SendData(i, MAPA_BROWSER_ID, jsonMap);

            // 2. JSON PARA O RADAR PEQUENO (ID 3)
            new Float:vx, Float:vy, Float:vz;
            GetPlayerCameraFrontVector(i, vx, vy, vz);
            new Float:camAngle = atan2(vy, vx) - 90.0;
            
            new jsonRadar[128];
            format(jsonRadar, sizeof(jsonRadar), "{\"x\":%.2f,\"y\":%.2f,\"a\":%.2f,\"ca\":%.2f}", x, y, a, camAngle);
            Geckoju_SendData(i, HUD_BROWSER_ID3, jsonRadar);
        }
    }
    return 1;
}

