public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
    // Verificamos se a tecla pressionada é o "Voltar" do celular (KEY_CTRL_BACK)
    if ((newkeys & KEY_CTRL_BACK) && !(oldkeys & KEY_CTRL_BACK))
    {
        // Executa a função de focar o mapa (independente de estar no carro ou a pé)
        cmd_focarmapa(playerid, ""); 
        
        // Retornamos 0 para BLOQUEAR a função nativa do jogo.
        // Isso impede que:
        // 1. O APK tente fechar o navegador/conexão.
        // 2. O carro buzine enquanto você tenta abrir o mapa.
        return 0; 
    }
    if(IsPlayerInRangeOfPoint(playerid, 3.0, 1682.688354, -2268.597656, 13.522749))
    {
        // Aqui você coloca o link do seu GitHub Pages onde está o localiza.html
        Geckoju_CreateBrowser(playerid, 101, 0, 0, 0, 0, "https://dieguin609.github.io/spawnselectomob/localiza.html", true, false);
        Geckoju_SetInteractive(playerid, 101, true);
    }

    // Tecla Y (Geralmente usada para interações)
    if((newkeys & KEY_YES) && !(oldkeys & KEY_YES))
    {
        // Suas interações aqui...
    }

    // Tecla N (Geralmente usada para cancelar/negar)
    if((newkeys & KEY_NO) && !(oldkeys & KEY_NO))
    {
        // Suas interações aqui...
    }

    return 1;
}

